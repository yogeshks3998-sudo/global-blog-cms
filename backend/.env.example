NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/global_blog_backend?retryWrites=true&w=majority
# If SRV DNS is blocked on your network, use the Atlas standard mongodb:// host list instead of mongodb+srv://.
JWT_SECRET=replace-with-a-long-random-secret-before-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,https://global-blog-cms.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
UPLOAD_DIR=uploads/blogs
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@blogcms.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=Admin@12345
